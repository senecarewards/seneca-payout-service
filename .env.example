PORT=3000

# A password you make up yourself — Frappe's Webhook will send this in a
# custom header so random people on the internet can't hit this endpoint.
WEBHOOK_SECRET=choose-a-long-random-string-here

# From Cashfree dashboard > Payouts > Developers > API Keys (Test mode)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox

# Your ERPNext site
FRAPPE_BASE_URL=https://senecatesting.m.frappe.cloud

# Generate from ERPNext: User menu (top-right) > My Settings > API Access >
# Generate Keys. Use a dedicated "Payout Bot" user with only the permissions
# it needs, not your own personal admin account.
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
